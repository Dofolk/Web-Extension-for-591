{
  "manifest_version": 3,
  "name": "租屋小幫手・已看過與房型多選",
  "version": "0.5.8",
  "description": "在 591 記錄已看過的房源，合併搜尋多種租屋類型。資料僅存於本機。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rent.591.com.tw/*"
      ],
      "js": [
        "core.js",
        "map.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "backup.html",
    "default_title": "租屋小幫手：備份與隱私"
  }
}